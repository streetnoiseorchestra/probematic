### Gemeinsam verwendete Aktionsbeschriftungen

add = Hinzufügen
back = Zurück
cancel = Abbrechen
create = Erstellen
delete = Löschen
done = Fertig
edit = Bearbeiten
more-actions = Weitere Aktionen
# Accessible label for the button that opens ancestors omitted from a breadcrumb trail.
# $count (Number) - The number of hidden breadcrumb items in the menu.
show-hidden-breadcrumb-items =
    { $count ->
        [one] Einen ausgeblendeten Eintrag im Navigationspfad anzeigen
       *[other] { $count } ausgeblendete Einträge im Navigationspfad anzeigen
    }
next = Weiter
remove = Entfernen
reorder = Neu anordnen
reissue-invitation = Neue Einladung ausstellen
respond = Antworten
resend-invitation = Einladung erneut senden
save = Speichern
select-all = Alle auswählen
update = Aktualisieren
view-all = Alle anzeigen
confirm-generic = Bist du sicher?
confirm-delete = Ja, löschen
