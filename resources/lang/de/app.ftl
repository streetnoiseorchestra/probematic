### Relative Zeitangaben

relative-time-now = jetzt
# $count (Number) - Anzahl der vergangenen Sekunden.
relative-time-seconds-ago =
    { $count ->
        [one] vor einer Sekunde
       *[other] vor { $count } Sekunden
    }
# $count (Number) - Anzahl der Sekunden bis zum Ereignis.
relative-time-seconds-within =
    { $count ->
        [one] in einer Sekunde
       *[other] in { $count } Sekunden
    }
# $count (Number) - Anzahl der vergangenen Minuten.
