### Relative time

relative-time-now = now
# $count (Number) - The number of elapsed seconds.
relative-time-seconds-ago =
    { $count ->
        [one] a second ago
       *[other] { $count } seconds ago
    }
# $count (Number) - The number of seconds until the event.
relative-time-seconds-within =
    { $count ->
        [one] in a second
       *[other] within { $count } seconds
    }
# $count (Number) - The number of elapsed minutes.
