                                                       :git/sha "874dcff0d140c32479c9d6e31c144582af157d86"}
        ;; REPL
        nrepl/nrepl                                    {:mvn/version "1.7.0"}
        integrant/repl                                 {:mvn/version "0.5.1"}
        cider/cider-nrepl                              {:mvn/version "0.59.0"}
        djblue/portal                                  {:mvn/version "0.64.1"}}
 :aliases
 {:kaocha {:extra-paths ["test"]
           :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
           :main-opts   ["-m" "kaocha.runner"]}
  :dev
  {:extra-paths ["env/dev/clj"
                 "env/dev/resources"
                 "test"]
   :extra-deps  {mvxcvi/puget                {:mvn/version "1.3.4"}
                 lambdaisland/ansi           {:mvn/version "0.2.37"}
                 io.github.tonsky/clj-reload {:mvn/version "1.0.0"}
                 no.cjohansen/lookup         {:mvn/version "2026.07.1"}
                 ;; browser driving
                 ;; etaoin/etaoin                        {:mvn/version "1.0.40"}
                 ;; testing
                 ;; org.clojure/test.check               {:mvn/version "1.1.1"}
                 ;; lambdaisland/kaocha                  {:mvn/version "1.88.1376"}
                 ;; cljfmt/cljfmt {:mvn/version "0.9.2"}
                 ;; com.github.gnl/playback              {:mvn/version "0.5.4"}
                 ;; com.github.seancorfield/expectations {:mvn/version "2.1.188"}
                 }

   :jvm-opts ["-Duser.timezone=UTC"
              "-Dguardrails.enabled=true"
              "-XX:+UseZGC"
              "-XX:-OmitStackTraceInFastThrow"
              "--enable-native-access=ALL-UNNAMED"
              "-Xmx4096m"
              ;; "--add-opens=java.base/java.nio=ALL-UNNAMED"
              ;; "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
              ]}
  :run-m {:main-opts ["-m" "app.main"]
          :jvm-opts  ["-XX:-OmitStackTraceInFastThrow"
                      "--enable-native-access=ALL-UNNAMED"]}
  :run-x {:ns-default app.main
          :jvm-opts   ["-XX:-OmitStackTraceInFastThrow"
                       "--enable-native-access=ALL-UNNAMED"]}
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
