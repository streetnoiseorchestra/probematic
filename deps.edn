        dev.weavejester/medley                         {:mvn/version "1.10.0"}
        tick/tick                                      {:mvn/version "1.0.1"}
        com.github.javafaker/javafaker                 {:mvn/version "1.0.2"}
        spootnik/signal                                {:mvn/version "0.2.5"}
        io.github.paintparty/bling                     {:mvn/version "0.10.0"}
        integrant/integrant                            {:mvn/version "1.0.1"}
        jarohen/chime                                  {:mvn/version "0.3.3"}
        nano-id/nano-id                                {:mvn/version "1.1.0"}
