{:paths ["resources" "src/clj" "src/java-classes"]

 :deps {org.clojure/clojure                            {:mvn/version "1.12.4"}
        org.clojure/core.cache                         {:mvn/version "1.2.263"}
        ;; org.clojure/data.generators                    {:mvn/version "1.1.0"}
        org.clojure/data.xml                           {:mvn/version "0.2.0-alpha11"}
        ;; Routing
        metosin/reitit                                 {:mvn/version "0.10.1"}
        ;; http-kit, ring, reitit
        metosin/ring-http-response                     {:mvn/version "0.9.5"}
        ring/ring-core                                 {:mvn/version "1.15.4"}
        http-kit/http-kit                              {:mvn/version "2.9.0-beta3"}
        ;; CTMX
        hiccup/hiccup                                  {:mvn/version "2.0.0"}
        org.clojure/data.json                          {:mvn/version "2.5.2"}
        ctmx/ctmx                                      {:mvn/version "1.4.7" :exclusions [;; use newer version of data.json that supports serializing uuids
                                                                                          org.clojure/data.json
                                                                                          ;; using newer version of hiccup
                                                                                          hiccup/hiccup
                                                                                          ;; exclude these fat cljs deps
                                                                                          ;; org.clojure/clojurescript
                                                                                          machhiato/hiccups]}
        ;; Datastar
        dev.onionpancakes/chassis                      {:mvn/version "1.0.365"}
        dev.data-star.clojure/sdk                      {:mvn/version "1.0.0-RC9"}
        dev.data-star.clojure/http-kit                 {:mvn/version "1.0.0-RC9"}
        datastar/expressions                           {:git/url "https://github.com/ramblurr/datastar-expressions/"
                                                        :git/sha "ae625bcc1d9267fc6c76fc96b44c87cdbfc81ac6"}
        org.flatland/ordered                           {:mvn/version "1.15.12"}
        ;; for Discourse integration
        clj-commons/clj-yaml                           {:mvn/version "1.0.29"}
        com.github.oliyh/martian                       {:mvn/version "0.1.30"}
        com.github.oliyh/martian-httpkit               {:mvn/version "0.1.30"}
        ;; Data
        aero/aero                                      {:mvn/version "1.1.6"}
        metosin/malli                                  {:mvn/version "0.20.1"}
        luminus-transit/luminus-transit                {:mvn/version "0.1.6" :exclusions [com.cognitect/transit-clj]}
        metosin/muuntaja                               {:mvn/version "0.6.11"}
        org.babashka/sci                               {:mvn/version "0.12.51"}
        com.taoensso/nippy                             {:mvn/version "3.5.0"}
        org.im4java/im4java                            {:git/tag "1.4.0-penpot-2" :git/sha "e2b3e16" :git/url "https://github.com/penpot/im4java"}
        com.googlecode.libphonenumber/libphonenumber   {:mvn/version "9.0.28"}
        ;; Documents + Files
        dk.ative/docjure                               {:mvn/version "1.22.0"}
        mvxcvi/blocks                                  {:mvn/version "2.1.0"}
        ;; Text
        io.github.nextjournal/markdown                 {:mvn/version "0.7.225"}
        ;; Compression - Assumes you deploy uberjar on linux x86_64
        com.aayushatharva.brotli4j/brotli4j            {:mvn/version "1.22.0"}
        com.aayushatharva.brotli4j/native-linux-x86_64 {:mvn/version "1.22.0"}
        ;; QR Codes
        com.google.zxing/javase                        {:mvn/version "3.5.4"}
        ;; Nextcloud {Cal,Web}DAV
        com.github.lookfirst/sardine                   {:mvn/version "5.13"}
        com.github.caldav4j/caldav4j                   {:mvn/version "1.0.5"}
        org.ehcache/ehcache                            {:mvn/version "3.12.0"
                                                        :exclusions  [org.glassfish.jaxb/jaxb-runtime]}
        ;; Error reporting & Logging
        ch.qos.logback/logback-classic                 {:mvn/version "1.5.32"}
        com.brunobonacci/mulog                         {:mvn/version "0.10.1"}
        com.brunobonacci/mulog-elasticsearch           {:mvn/version "0.10.1"}
        ;; i18n
        com.taoensso/tempura                           {:mvn/version "1.5.4"}
        ;; Database
        com.datomic/local                              {:mvn/version "1.0.291"}
        com.datomic/peer                               {:mvn/version "1.0.7556"}
        org.xerial/sqlite-jdbc                         {:mvn/version "3.53.0.0"}
        dev.gethop/stork                               {:mvn/version "0.1.7"}
        com.fulcrologic/guardrails                     {:mvn/version "1.3.1"}
        com.yetanalytics/colossal-squuid               {:mvn/version "0.1.5"
                                                        :exclusions  [org.clojure/clojure org.clojure/clojurescript]}
        com.taoensso/carmine                           {:mvn/version "3.5.0"}
        ;; Authorization and Authentication
        buddy/buddy-core                               {:mvn/version "1.12.0-430"}
        buddy/buddy-sign                               {:mvn/version "3.6.1-359"}
        keycloak-clojure/keycloak-clojure              {:mvn/version "1.31.5"}
        ;; SMTP Email
        toyokumo/tarayo                                {:mvn/version "0.2.8"}
        ;; Util
        selmer/selmer                                  {:mvn/version "1.13.1"}
        dev.weavejester/medley                         {:mvn/version "1.10.0"}
        tick/tick                                      {:mvn/version "1.0"}
        com.github.javafaker/javafaker                 {:mvn/version "1.0.2"}
        spootnik/signal                                {:mvn/version "0.2.5"}
        io.github.paintparty/bling                     {:mvn/version "0.10.0"}
        integrant/integrant                            {:mvn/version "1.0.1"}
        jarohen/chime                                  {:mvn/version "0.3.3"}
        nano-id/nano-id                                {:mvn/version "1.1.0"}
        ;; FCIS/Effects System
        no.cjohansen/nexus                             {:mvn/version "2025.11.1"}
        ;; REPL
        nrepl/nrepl                                    {:mvn/version "1.7.0"}
        integrant/repl                                 {:mvn/version "0.5.1"}
        cider/cider-nrepl                              {:mvn/version "0.59.0"}
        djblue/portal                                  {:mvn/version "0.64.1"}}
 :aliases
 {:kaocha {:extra-paths ["test"]
           :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
           :main-opts   ["-m" "kaocha.runner"]}
  :dev
  {:extra-paths ["env/dev/clj"
                 "env/dev/resources"
                 "test"]
   :extra-deps  {mvxcvi/puget                {:mvn/version "1.3.4"}
                 lambdaisland/ansi           {:mvn/version "0.2.37"}
                 io.github.tonsky/clj-reload {:mvn/version "1.0.0"}
                 ;; browser driving
                 ;; etaoin/etaoin                        {:mvn/version "1.0.40"}
                 ;; testing
                 ;; org.clojure/test.check               {:mvn/version "1.1.1"}
                 ;; lambdaisland/kaocha                  {:mvn/version "1.88.1376"}
                 ;; cljfmt/cljfmt {:mvn/version "0.9.2"}
                 ;; com.github.gnl/playback              {:mvn/version "0.5.4"}
                 ;; com.github.seancorfield/expectations {:mvn/version "2.1.188"}
                 }

   :jvm-opts ["-Duser.timezone=UTC"
              "-Dguardrails.enabled=true"
              "-XX:+UseZGC"
              "-XX:-OmitStackTraceInFastThrow"
              "--enable-native-access=ALL-UNNAMED"
              ;; "--add-opens=java.base/java.nio=ALL-UNNAMED"
              ;; "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
              ]}
  :run-m {:main-opts ["-m" "app.main"] :jvm-opts ["-XX:-OmitStackTraceInFastThrow"]}
  :run-x {:ns-default app.main :jvm-opts ["-XX:-OmitStackTraceInFastThrow"]}
  :build {:deps       {io.github.clojure/tools.build {:git/tag "v0.10.13"
                                                      :git/sha "ae52edfedef4ca72e699e9c86abfe0940e97dc26"}}
          :ns-default build}}}
